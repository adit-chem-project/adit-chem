#!/bin/bash
{% if lang == "en" %}
# generated by adit {{ app_version }} ({{ created }}). Pre-submission check for Slurm (profile {{ runtime.profile }}). It never submits.
# Usage: on your PC, in this directory:  bash check_remote.sh   (one OK / NG line per check)
{% else %}
# adit {{ app_version }} が生成 ({{ created }})。Slurm への投入前の疎通確認 (プロファイル {{ runtime.profile }})。投入はしません。
# 使い方: 手元の PC で、このディレクトリで  bash check_remote.sh   (確認ごとに OK / NG を 1 行ずつ出します)
{% endif %}
HERE="$(cd "$(dirname "$0")" && pwd)"
TARGET="{{ target }}"
REMOTE_DIR="{{ remote_dir }}"
SSH="ssh -o BatchMode=yes -o ConnectTimeout=10"
fail=0
ok() { echo "OK: $1"; }
ng() { echo "NG: $1"; fail=1; }
remote() { printf '%s\n' "$@" | $SSH "$TARGET" bash -l -s 2>&1; }
{% if modules %}
MODULE_PRELUDE='command -v module >/dev/null 2>&1 || { [ -r /etc/profile ] && . /etc/profile; }; command -v module >/dev/null 2>&1 || exit 2; module purge >/dev/null 2>&1{% for m in modules %}; module load {{ m }} || exit 1{% endfor %}'
{% else %}
MODULE_PRELUDE=':'
{% endif %}

case "$TARGET$REMOTE_DIR" in
  *'<'*) ng "{{ 'host / remote_dir are still <...>: set them in the profile and generate again' if lang == 'en' else 'host / remote_dir が <...> のままです。環境設定のプロファイルに書いて生成し直してください' }}"; exit 1;;
esac

# 1. ssh
if $SSH "$TARGET" true 2>/dev/null; then
  ok "ssh $TARGET"
else
  ng "{{ 'cannot log in to ' if lang == 'en' else 'ログインできない: ' }}$TARGET{{ ' (check the key / ssh-agent)' if lang == 'en' else ' (鍵か ssh-agent の設定を確認)' }}"
  exit 1
fi

# 2. module
{% if modules %}
out=$(remote "$MODULE_PRELUDE"); rc=$?
case $rc in
  0) ok "module load {{ modules | join(' ') }}";;
  2) ng "{{ 'module command not found on the cluster' if lang == 'en' else 'クラスタに module コマンドが無い' }}";;
  *) ng "module load {{ modules | join(' ') }}{{ ' failed: ' if lang == 'en' else ' に失敗: ' }}$(echo "$out" | tail -n 3 | tr '\n' ' ')";;
esac
{% else %}
ok "{{ 'no modules in the profile (nothing to load)' if lang == 'en' else 'プロファイルに module の指定なし (読み込みは省略)' }}"
{% endif %}

# 3. {{ 'executable' if lang == 'en' else '実行ファイル' }}
{% for name in programs %}
{% if '/' in name %}
out=$(remote "$MODULE_PRELUDE" "test -x '{{ name }}' && echo '{{ name }}'"); rc=$?
{% else %}
out=$(remote "$MODULE_PRELUDE" "command -v {{ name }}"); rc=$?
{% endif %}
if [ $rc -eq 0 ] && [ -n "$out" ]; then ok "{{ name }}: $(echo "$out" | tail -n 1)"; else ng "{{ name }}{{ ' not found after loading the modules' if lang == 'en' else ' が見つからない (module を読み込んだあとの PATH に無い)' }}"; fi
{% endfor %}

# 4. remote_dir
if remote "mkdir -p '$REMOTE_DIR' && touch '$REMOTE_DIR/.adit_check_remote' && rm -f '$REMOTE_DIR/.adit_check_remote'" >/dev/null; then
  ok "{{ 'can write to ' if lang == 'en' else '書き込める: ' }}$REMOTE_DIR"
else
  ng "{{ 'cannot write to ' if lang == 'en' else '書き込めない: ' }}$REMOTE_DIR"
fi

# 5. {{ 'sbatch --test-only validates submit.sh and reports when it could start, without submitting' if lang == 'en' else 'sbatch --test-only は submit.sh を検査して、いつ始まれそうかを表示するだけで、投入はしません' }}
out=$($SSH "$TARGET" "cd '$REMOTE_DIR' && sbatch --test-only" < "$HERE/submit.sh" 2>&1); rc=$?
if [ $rc -eq 0 ]; then
  ok "sbatch --test-only submit.sh: $(echo "$out" | tail -n 1)"
else
  ng "sbatch --test-only submit.sh: $(echo "$out" | tail -n 1)"
fi

if [ $fail -eq 0 ]; then
  echo "{{ 'all OK. Submit with the commands in transfer_and_submit.sh' if lang == 'en' else 'すべて OK です。投入は transfer_and_submit.sh のコマンドで行います' }}"
else
  echo "{{ 'there are NG lines. Fix the settings before submitting' if lang == 'en' else 'NG があります。投入する前に設定を直してください' }}"
fi
exit $fail
