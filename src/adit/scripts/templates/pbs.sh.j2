#!/bin/sh
#PBS -N {{ runtime.job_name }}
#PBS -l select={{ runtime.nodes }}:ncpus={{ runtime.ncpus }}:mpiprocs={{ runtime.mpiprocs }}:ompthreads={{ runtime.omp_threads }}{{ profile.select_extra }}
#PBS -l walltime={{ runtime.walltime }}
#PBS -j oe
{% for line in profile.header_extra %}
{{ line }}
{% endfor %}
{% if lang == "en" %}
# generated by adit {{ app_version }} ({{ created }}). Target: PBS (profile {{ runtime.profile }})
# Usage: transfer this directory and run  {{ profile.submit }} submit.sh  inside it
{% else %}
# adit {{ app_version }} が生成 ({{ created }})。実行先: PBS (プロファイル {{ runtime.profile }})
# 使い方: このディレクトリを転送し、その中で  {{ profile.submit }} submit.sh
{% endif %}

if [ ! -z "${PBS_O_WORKDIR}" ]; then
   cd "${PBS_O_WORKDIR}"
fi

{% if lang == "en" %}
# module may be undefined under #!/bin/sh. Source /etc/profile first, then check (stop with a reason if still missing)
{% else %}
# #!/bin/sh では module が未定義なことがある。/etc/profile を読んでから確かめる (無ければ理由を出して止まる)
{% endif %}
{% if modules %}
if ! command -v module >/dev/null 2>&1; then
   [ -r /etc/profile ] && . /etc/profile
fi
command -v module >/dev/null 2>&1 || { echo "{{ 'module command not available (not found even after sourcing /etc/profile)' if lang == 'en' else 'module コマンドが使えない (/etc/profile を読んでも見つからない)' }}" >&2; exit 1; }
module purge
{% for m in modules %}
module load {{ m }} || { echo "{{ 'module load ' ~ m ~ ' failed' if lang == 'en' else 'module load ' ~ m ~ ' に失敗' }}" >&2; exit 1; }
{% endfor %}
{% endif %}

export OMP_NUM_THREADS={{ runtime.omp_threads }}
{% for k, v in env.items() %}
export {{ k }}="{{ v }}"
{% endfor %}
ulimit -s unlimited
{{ run_command }}
