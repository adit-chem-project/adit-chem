# ADIT が生成した Psi4 の入力 / Psi4 input generated by ADIT
# 手法・基底・参照波動関数は利用者が指定したものです / the method, basis and reference come from the user

molecule adit {
  0 1
  O 0.0000000000 0.0000000000 0.1192620000
  H 0.0000000000 0.7632390000 -0.4770470000
  H 0.0000000000 -0.7632390000 -0.4770470000
  units angstrom
  no_reorient
  no_com
  symmetry c1
}

set basis cc-pVDZ
set geom_maxiter 20

import json

# 下の 2 行の目印は、Psi4 が出力の先頭へ写す入力の行と重ならないよう、文字列を分けてあります
psi4.core.print_out("adit-" "psi4: psi4 " + psi4.__version__ + "\n")
energy_hartree, wfn = optimize('scf', return_wfn=True)
results = {"task": 'geometry_optimization', "method": 'scf', "basis": 'cc-pVDZ', "psi4_version": psi4.__version__,
           "energy_hartree": float(energy_hartree)}
mol = psi4.core.get_active_molecule()
mol.save_xyz_file('final.xyz', True)
results["geom_maxiter"] = 20
results["converged"] = True
psi4.core.print_out("adit-" "psi4: psi4 " + psi4.__version__ + "\n")
with open('results.json', "w") as handle:
    json.dump(results, handle, indent=2)
psi4.core.print_out("adit-" "psi4: done " + json.dumps(results) + "\n")
