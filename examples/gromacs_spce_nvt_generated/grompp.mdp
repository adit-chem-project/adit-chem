; GROMACS mdp generated by ADIT (options checked against https://manual.gromacs.org/current/user-guide/mdp-options.html)
integrator         = md
nsteps             = 250
dt                 = 0.002
nstxout-compressed = 25
nstenergy          = 25
nstlog             = 25
cutoff-scheme      = Verlet
coulombtype        = PME
rcoulomb           = 0.85
rvdw               = 0.85
constraints        = none
tcoupl             = V-rescale
tc-grps            = System
tau-t              = 0.1
ref-t              = 300
pcoupl             = no
gen-vel            = yes
gen-temp           = 300
gen-seed           = -1
