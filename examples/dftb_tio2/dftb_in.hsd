# ------------------------------------------------------------------------------
# Periodic SCC calculation of anatase TiO2 (reproduces stage 1, "Creating the proper input charges",
# of the official recipe "Band structure, DOS and PDOS"). Reference example of periodic DFTB+
#
# Source: https://dftbplus-recipes.readthedocs.io/en/latest/basics/bandstruct.html
#       (recipes/basics/bandstruct/1_density/dftb_in.hsd in the distributed archive recipes.tar.bz2)
# There are only 3 differences from the original:
#   1. The structure is read from geometry.gen with <<< (contents identical to the original)
#   2. The Prefix of the SK files is ../../slakos/mio-ext/
#      (mio-ext has the same layout as the original: symbolic links to mio-1-1 and tiorg-0-1)
#   3. This # comment
# ------------------------------------------------------------------------------

# === Geometry: periodic system (equivalent to POSCAR) ===
# The F in the first gen line, "6 F", means "periodic cell, fractional coordinates". One origin line and 3 lattice-vector lines follow at the end
# (unlike "C" for molecules). Coordinates are fractions of the lattice vectors
Geometry = GenFormat {
  <<< "geometry.gen"
}

# === Driver: none = single point (the structure does not move) ===

# === Hamiltonian ===
Hamiltonian = DFTB {
  Scc = Yes
  SccTolerance = 1e-5              # given explicitly in the original (same value as the default)
  SlaterKosterFiles = Type2FileNames {
    Prefix = "../../slakos/mio-ext/"
    Separator = "-"
    Suffix = ".skf"
  }
  MaxAngularMomentum {
    Ti = "d"                       # from <Shells>3d 4s 4p</Shells> at the end of Ti-Ti.skf in tiorg-0-1
    O  = "p"                       # from <Shells>2s 2p</Shells> at the end of O-O.skf in mio-1-1
  }
  KPointsAndWeights = SupercellFolding {   # k-points (equivalent to KPOINTS). Equivalent to 4x4x4 Monkhorst-Pack
    4 0 0                          # folding matrix (if diagonal, the divisions along each direction)
    0 4 0
    0 0 4
    0.5 0.5 0.5                    # shift. 0.5 gives the same points as an MP grid with even divisions
  }
}

# === Analysis: density of states projected by element and shell (as in the original; writes band.out and dos_*.out) ===
Analysis {
  ProjectStates {
    Region {
      Atoms = Ti
      ShellResolved = Yes
      Label = "dos_ti"
    }
    Region {
      Atoms = O
      ShellResolved = Yes
      Label = "dos_o"
    }
  }
}

ParserOptions {
  ParserVersion = 12               # as in the original. The parser version in this environment (25.1) is 14; converted automatically
}
