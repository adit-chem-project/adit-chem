# ADIT が生成した CP2K の入力 (キーワードは CP2K 2026.2 の入力の説明で確かめたもの)
&GLOBAL
  PROJECT adit
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_adit
    POTENTIAL_FILE_NAME POTENTIAL_adit
    CHARGE 0
    MULTIPLICITY 1
    &MGRID
      CUTOFF 280
      REL_CUTOFF 40
    &END MGRID
    &SCF
      EPS_SCF 1e-05
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      A 6.0000000000 0.0000000000 0.0000000000
      B 0.0000000000 6.0000000000 0.0000000000
      C 0.0000000000 0.0000000000 6.0000000000
      PERIODIC NONE
    &END CELL
    &COORD
      O      0.0000000000     0.0000000000     0.1192620000
      H      0.0000000000     0.7632390000    -0.4770470000
      H      0.0000000000    -0.7632390000    -0.4770470000
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
