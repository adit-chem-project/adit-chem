# ADIT が生成した ABINIT の入力 / ABINIT input generated by ADIT
# 長さの単位は Bohr (ABINIT の既定) / lengths are in bohr (the ABINIT default)

# ---- 構造 / structure ----
acell 1.0 1.0 1.0
rprim
  0 5.13060642836 5.13060642836
  5.13060642836 0 5.13060642836
  5.13060642836 5.13060642836 0
natom 2
ntypat 1
znucl 14
typat 1 1
xred
  0 0 0
  0.25 0.25 0.25

# ---- 擬ポテンシャル / pseudopotentials ----
pp_dirpath "./"
pseudos "14si.pspnc"

# ---- 計算の条件 / calculation ----
ecut 8
chkprim 0
nstep 30
toldfe 1e-08

# ---- k 点 / k-points ----
ngkpt 4 4 4
nshiftk 1
shiftk 0 0 0
