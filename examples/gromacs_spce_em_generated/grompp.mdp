; GROMACS mdp generated by ADIT (options checked against https://manual.gromacs.org/current/user-guide/mdp-options.html)
integrator    = steep
nsteps        = 50
emtol         = 1000
nstenergy     = 1
nstlog        = 1
cutoff-scheme = Verlet
coulombtype   = PME
rcoulomb      = 0.85
rvdw          = 0.85
constraints   = none
