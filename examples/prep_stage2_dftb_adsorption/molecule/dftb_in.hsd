Geometry = GenFormat {
  <<< "geometry.gen"
}

Driver {}

Hamiltonian = DFTB {
  Scc = Yes
  SccTolerance = 1e-05
  MaxSccIterations = 100
  SlaterKosterFiles = Type2FileNames {
    Prefix = "skf/"
    Separator = "-"
    Suffix = ".skf"
  }
  MaxAngularMomentum {
    O = "p"
    H = "s"
  }
}

Options {
  RandomSeed = 12345
  WriteResultsTag = Yes
}

Analysis {
  PrintForces = Yes
}

ParserOptions {
  ParserVersion = 14
}
