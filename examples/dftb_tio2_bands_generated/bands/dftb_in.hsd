Geometry = GenFormat {
  <<< "../geometry.gen"
}

Driver {}

Hamiltonian = DFTB {
  Scc = Yes
  ReadInitialCharges = Yes
  MaxSccIterations = 1
  ConvergentSccOnly = No
  SlaterKosterFiles = Type2FileNames {
    Prefix = "../skf/"
    Separator = "-"
    Suffix = ".skf"
  }
  MaxAngularMomentum {
    Ti = "d"
    O = "p"
  }
  KPointsAndWeights = Klines {
    1  0.000000 0.000000 0.000000   # G
    9  -0.500000 0.500000 0.000000   # X
    6  -0.288275 0.288275 -0.288275   # S
    7  0.000000 0.000000 0.000000   # G
    5  0.500000 0.500000 -0.500000   # Z
    5  0.288275 0.711725 -0.711725   # S1
    2  0.000000 0.500000 -0.500000   # N
    8  -0.250000 0.750000 -0.250000   # P
    3  0.076550 0.923450 -0.500000   # Y1
    10  0.500000 0.500000 -0.500000   # Z
    4  -0.250000 0.750000 -0.250000   # P
  }
}

Options {
  RandomSeed = 12345
  WriteResultsTag = Yes
}

Analysis {
  PrintForces = Yes
}

ParserOptions {
  ParserVersion = 14
}
