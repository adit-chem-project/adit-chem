Geometry = GenFormat {
  <<< "geometry.gen"
}

Driver = VelocityVerlet {
  MovedAtoms = 1:-1
  Steps = 20
  TimeStep [fs] = 0.5
  MDRestartFrequency = 1
  OutputPrefix = "geo_end"
  Velocities [AA/ps] {
    <<< "velocities.dat"
  }
  Thermostat = None {}
}

Hamiltonian = DFTB {
  Scc = Yes
  SccTolerance = 1e-05
  MaxSccIterations = 100
  SlaterKosterFiles = Type2FileNames {
    Prefix = "skf/"
    Separator = "-"
    Suffix = ".skf"
  }
  MaxAngularMomentum {
    O = "p"
    H = "s"
  }
}

Options {
  RandomSeed = 12345
  WriteResultsTag = Yes
}

Analysis {
  PrintForces = Yes
}

ParserOptions {
  ParserVersion = 14
}
