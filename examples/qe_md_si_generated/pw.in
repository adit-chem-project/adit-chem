&CONTROL
   calculation      = 'md'
   nstep            = 20
   iprint           = 1
   tstress          = .true.
   tprnfor          = .true.
   dt               = 41.34110546116003
   outdir           = './tmp'
   prefix           = 'adit'
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 30.0
   ecutrho          = 120.0
   nosym            = .true.
   occupations      = 'fixed'
   nspin            = 1
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 100
   conv_thr         = 1e-06
   mixing_beta      = 0.7
/
&IONS
   ion_dynamics     = 'verlet'
   ion_temperature  = 'berendsen'
   tempw            = 300.0
   nraise           = 20
/
&CELL
/
&FCP
/
&RISM
/
