# ------------------------------------------------------------------------------
# Geometry optimization of a water molecule (reproduces the official tutorial "First calculation with DFTB+")
#
# Source: https://dftbplus-recipes.readthedocs.io/en/latest/basics/firstcalc.html
#       (recipes/basics/firstcalc/dftb_in.hsd in the distributed archive recipes.tar.bz2)
# There are only 3 differences from the original:
#   1. The structure is read from geometry.gen with <<< instead of being written inside the Geometry block
#      (a form shown on the same page)
#   2. The Slater-Koster file path is ../../slakos/mio-1-1/
#      (the original ../../slakos/mio-ext/ is a set of symbolic links to mio-1-1 in the
#       distributed archive; the 4 O,H files needed for water all come from mio-1-1)
#   3. This # comment
#
# HSD format rules:
#   - Blocks can be in any order. Keywords and unit names are case-insensitive
#   - Strings (such as file names) are case-sensitive
#   - From # to the end of the line is a comment
#   - The default units for numbers are atomic units (Hartree, Bohr). Square brackets change the unit, as in [eV/AA]
# ------------------------------------------------------------------------------

# === Geometry: atom types and coordinates (POSCAR in VASP) ===
# Reads a gen-format file as is. See geometry.gen for the contents of the gen format.
Geometry = GenFormat {
  <<< "geometry.gen"
}

# === Driver: how the structure moves (equivalent to IBRION / NSW / EDIFFG in VASP) ===
# An empty Driver {} or omitting the whole block gives a single point.
Driver = GeometryOptimization {
  Optimizer = Rational {}          # rational-function optimizer (augmented Hessian + BFGS-type update)
  MovedAtoms = 1:-1                # moves all atoms from the first through the last (-1)
  MaxSteps = 100                   # maximum number of geometry optimization steps (NSW in VASP)
  OutputPrefix = "geom.out"        # writes the final structure to geom.out.gen and geom.out.xyz
  Convergence {GradElem = 1E-4}    # converged when the largest force component falls below 1E-4 Hartree/Bohr
                                   # (the same "force" criterion as EDIFFG < 0 in VASP; atomic units)
}

# === Hamiltonian: model for the electronic structure (equivalent to the INCAR method settings + POTCAR) ===
Hamiltonian = DFTB {
  Scc = Yes                        # self-consistent charges (SCC-DFTB). Solves charge transfer between atoms iteratively
                                   # the convergence check SccTolerance (default 1e-5 electrons) and
                                   # the iteration limit MaxSccIterations (default 100) stay at their defaults
  SlaterKosterFiles {              # parameter files per element pair (equivalent to POTCAR, but per pair)
    O-O = "../../slakos/mio-1-1/O-O.skf"
    O-H = "../../slakos/mio-1-1/O-H.skf"
    H-O = "../../slakos/mio-1-1/H-O.skf"
    H-H = "../../slakos/mio-1-1/H-H.skf"
  }
  MaxAngularMomentum {             # highest orbital angular momentum used for each element (s / p / d / f)
    O = "p"                        # values come from the set's documentation (the notes at the end of the skf)
    H = "s"
  }
}

# === Options: settings for the whole program. Can be empty (same as omitting it) ===
Options {}

# === Analysis: additional quantities to compute and print ===
Analysis {
  CalculateForces = Yes            # writes all force components to detailed.out (not needed for the optimization itself)
                                   # note: the official name in 25.1 is PrintForces. CalculateForces is the old name in
                                   # parser version 12, converted to PrintForces automatically because of ParserVersion = 12
                                   # (confirmed in the 2026-09-10 run: standard output shows WARNING "Keyword renamed to
                                   # 'PrintForces'", and dftb_pin.hsd expands it to PrintForces = Yes)
}

# === ParserOptions: directives for the input parser itself ===
ParserOptions {
  ParserVersion = 12               # parser version when this input was written. Newer versions convert it automatically
                                   # (the parser version of DFTB+ 25.1 in this environment is 14)
}
